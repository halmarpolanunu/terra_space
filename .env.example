# Optional: change this only when LM Studio listens on a different local address.
TERRA_LM_STUDIO_URL=http://host.docker.internal:1234

# Optional: backend-only. Enables the read-only Supabase preview on Sources, Event Review,
# Events, and Dashboard (see project-knowledge/plans/2026-08-11-supabase-read-only-bridge-design.md).
# Leave unset and those screens report the preview as unavailable instead of silently showing
# stale SQLite data. This is never read by the frontend container -- do not add it there.
# Point this at your local Supabase's exposed database port (54322 by default); use your own
# real password, never the placeholder below, and never commit this file with a real value.
# TERRA_SUPABASE_URL=postgresql+psycopg://postgres:REPLACE_WITH_YOUR_PASSWORD@host.docker.internal:54322/postgres
