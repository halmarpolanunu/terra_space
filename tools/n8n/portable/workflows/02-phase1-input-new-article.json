  "nodes": [
    {
      "parameters": {
        "formTitle": "Terra Space - Manual News Entry (Phase 1)",
        "formDescription": "Save one news article now. It will be queued for cleaning when you later run Process All Saved Articles.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Published Date",
              "fieldType": "date",
              "fieldName": "p1_published_date",
              "requiredField": true
            },
            {
              "fieldLabel": "Title",
              "fieldName": "p1_title",
              "placeholder": "Italian students apologise after Bangkok train incident sparks outrage in Thailand",
              "requiredField": true
            },
            {
              "fieldLabel": "Raw Content Text",
              "fieldType": "textarea",
              "fieldName": "p1_raw_content_text",
              "placeholder": "Five Italian students and their supervisor have apologised to a Thai woman after a video of their confrontation on a Bangkok train went viral.",
              "requiredField": true
            },
            {
              "fieldLabel": "Source Domain",
              "fieldName": "p1_source_domain",
              "placeholder": "independent.co.uk",
              "requiredField": true
            },
            {
              "fieldLabel": "Source URL",
              "fieldName": "p1_source_url",
              "placeholder": "https://www.independent.co.uk/asia/southeast-asia/bangkok-bts-train-incident-italian-students-apology-b3022046.html",
              "requiredField": true
            },
            {
              "fieldLabel": "Author",
              "fieldName": "p1_author",
              "placeholder": "Optional"
            }
          ]
        },
        "options": {
          "path": "terra-space-manual-news-entry"
        }
      },
      "id": "form_trigger_manual_p1",
      "name": "Manual News Entry Form (Phase 1)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        32,
        -192
      ],
      "webhookId": "989a6527-a73a-48cb-8759-a6a2b3424021"
    },
    {
      "parameters": {
        "tableId": "=terra_space_phase1_sources",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "title",
              "fieldValue": "={{ $json.p1_title }}"
            },
            {
              "fieldId": "publication_date",
              "fieldValue": "={{ $json.p1_published_date }}"
            },
            {
              "fieldId": "raw_content_text",
              "fieldValue": "={{ $json.p1_raw_content_text }}"
            },
            {
